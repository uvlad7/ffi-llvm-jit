#!/usr/bin/env bash
#MISE description="Spin up Windows Server 2022 VM (dockur/windows) for debugging ruby-llvm Windows install"
#USAGE flag "--rebuild" help="Destroy persistent storage and start fresh"
#USAGE flag "--iso <path>" help="Use a local Windows ISO instead of downloading; only valid combined with --rebuild (cached and auto-reused on later runs)"
#USAGE flag "--backup" help="Back up the VM disk volume to a uniquely-named snapshot (debug-win-storage/backups/) and exit"
#USAGE flag "--restore <name>" help="Restore the VM disk volume from a snapshot created by --backup, then exit"
#USAGE flag "--shell <shell>" {
#USAGE   help "Shell for the final SSH session: powershell (with ridk enable already applied), cmd, bash (MSYS2 MINGW64, 64-bit Ruby), bash32 (MSYS2 MINGW32, 32-bit Ruby — stdcall calling convention), cygwin (Cygwin bash — C errno and GetLastError() are separate channels), mswin (MSVC Ruby — PowerShell with VS developer environment; for cmd instead: mswin-cmd)"
#USAGE   default "powershell"
#USAGE   choices "powershell" "cmd" "bash" "bash32" "cygwin" "mswin" "mswin-cmd"
#USAGE }
set -euo pipefail

PROJECT_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
VOLUME="ffi-llvm-jit-win-storage"
STORAGE_DIR="${PROJECT_ROOT}/mise-tasks/debug-win-storage"
OEM_DIR="${STORAGE_DIR}/win-oem"
SSH_KEY="${STORAGE_DIR}/win_ssh_key"
SENTINEL="${STORAGE_DIR}/win-setup-done"
INSTALL_LOG="${STORAGE_DIR}/win-install.log"
ISO_CACHE="${STORAGE_DIR}/last-iso-path"
BACKUP_DIR="${STORAGE_DIR}/backups"
RUN_CONTAINER="ffi-llvm-jit-win-run-$$"

if [[ -n "${usage_backup:-}" && -n "${usage_restore:-}" ]]; then
  echo "ERROR: --backup and --restore cannot be used together" >&2
  exit 1
fi

# Volume snapshots, taken via https://github.com/loomchild/volume-backup. Both
# exit before any VM is started; the disk volume must not be in use, since a
# live container writing to it would make the snapshot inconsistent. Alongside
# the volume itself, a backup also bundles the host-side files that have to
# stay consistent with it: the SSH keypair (the VM's authorized_keys was baked
# in from this key at install time — a freshly-generated key won't match it),
# the custom-ISO cache (dockur/windows wipes the disk and reinstalls if a
# custom-ISO install ever boots without that same ISO mounted), and the setup
# sentinel (otherwise a restored-but-already-set-up VM looks like a fresh
# first-time install to the wait loop below).
if [[ -n "${usage_backup:-}" ]]; then
  if [[ -n "$(docker ps -q --filter volume="$VOLUME")" ]]; then
    echo "ERROR: VM volume '$VOLUME' is in use by a running container; stop it first" >&2
    exit 1
  fi
  name="$(date +%Y%m%d-%H%M%S)"
  dest="${BACKUP_DIR}/${name}"
  mkdir -p "$dest"
  echo "==> Backing up volume '$VOLUME' to backups/${name}/volume.tar.bz2..."
  docker run -v "${VOLUME}:/volume" --rm --log-driver none loomchild/volume-backup backup > "${dest}/volume.tar.bz2"
  [[ -f "$SSH_KEY" ]] && cp -p "$SSH_KEY" "${dest}/win_ssh_key"
  [[ -f "${SSH_KEY}.pub" ]] && cp -p "${SSH_KEY}.pub" "${dest}/win_ssh_key.pub"
  [[ -f "$ISO_CACHE" ]] && cp -p "$ISO_CACHE" "${dest}/last-iso-path"
  [[ -f "$SENTINEL" ]] && cp -p "$SENTINEL" "${dest}/win-setup-done"
  [[ -f "$INSTALL_LOG" ]] && cp -p "$INSTALL_LOG" "${dest}/win-install.log"
  echo "==> Backup saved as '${name}'. Restore with: --restore ${name}"
  exit 0
fi

if [[ -n "${usage_restore:-}" ]]; then
  src="${BACKUP_DIR}/${usage_restore}"
  if [[ ! -f "${src}/volume.tar.bz2" ]]; then
    echo "ERROR: Backup not found: ${src}/volume.tar.bz2" >&2
    exit 1
  fi
  if [[ -n "$(docker ps -q --filter volume="$VOLUME")" ]]; then
    echo "ERROR: VM volume '$VOLUME' is in use by a running container; stop it first" >&2
    exit 1
  fi
  echo "==> Restoring volume '$VOLUME' from backups/${usage_restore}/volume.tar.bz2..."
  # Wipe first: volume-backup's restore requires an empty target volume, and
  # `docker run -v` below recreates it fresh (and empty) since it no longer exists.
  docker volume rm "$VOLUME" >/dev/null 2>&1 || true
  docker run -i -v "${VOLUME}:/volume" --rm loomchild/volume-backup restore < "${src}/volume.tar.bz2"
  # Clear current host-side state before restoring the backup's copies, so
  # nothing from the previous (now-overwritten) volume lingers inconsistently.
  rm -f "$SSH_KEY" "${SSH_KEY}.pub" "$ISO_CACHE" "$SENTINEL" "$INSTALL_LOG"
  [[ -f "${src}/win_ssh_key" ]] && cp -p "${src}/win_ssh_key" "$SSH_KEY"
  [[ -f "${src}/win_ssh_key.pub" ]] && cp -p "${src}/win_ssh_key.pub" "${SSH_KEY}.pub"
  [[ -f "${src}/last-iso-path" ]] && cp -p "${src}/last-iso-path" "$ISO_CACHE"
  [[ -f "${src}/win-setup-done" ]] && cp -p "${src}/win-setup-done" "$SENTINEL"
  [[ -f "${src}/win-install.log" ]] && cp -p "${src}/win-install.log" "$INSTALL_LOG"
  echo "==> Restore complete. Run debug-win again (without --restore) to boot it."
  exit 0
fi

if [[ -n "${usage_rebuild:-}" ]]; then
  echo "WARNING: --rebuild destroys Docker volume '$VOLUME' and all VM data." >&2
  echo "         A full Windows reinstall (~15 min) will be required." >&2
  read -r -p "Type 'yes' to confirm: " _rebuild_confirm
  if [[ "$_rebuild_confirm" != "yes" ]]; then
    echo "Aborted." >&2
    exit 1
  fi
  docker volume rm "$VOLUME" 2>/dev/null || true
  rm -f "$SENTINEL" "$INSTALL_LOG" "$ISO_CACHE"
fi

mkdir -p "$OEM_DIR"

# Generate SSH keypair once; persists in debug-win-storage/ (gitignored)
if [[ ! -f "$SSH_KEY" ]]; then
  echo "==> Generating SSH keypair..."
  ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -C "ffi-llvm-jit-win-debug"
fi
cp "${SSH_KEY}.pub" "${OEM_DIR}/authorized_keys"

# install.bat runs once automatically after Windows finishes its initial setup.
# It installs RubyInstaller + MSYS2 toolchain + LLVM and maps the project share.
cat > "$OEM_DIR/install.bat" << 'ENDBAT'
@echo off
setlocal
chcp 65001 >nul

set LOG=Z:\mise-tasks\debug-win-storage\win-install.log

:wait_share
net use Z: \\host.lan\Data /persistent:yes >nul 2>&1
if errorlevel 1 (
  timeout /t 2 >nul
  goto wait_share
)

echo ==^> Project share mapped to Z:\... > %LOG%
echo ==^> Enabling remote elevation for local admin accounts (UAC token policy)... >> %LOG%
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v LocalAccountTokenFilterPolicy /t REG_DWORD /d 1 /f >> %LOG% 2>&1

echo ==^> Waiting for network connectivity... >> %LOG%
:wait_network
ping -n 1 8.8.8.8 >nul 2>&1
if errorlevel 1 (
  timeout /t 2 >nul
  goto wait_network
)
echo ==^> Network is up. >> %LOG%

echo ==^> Installing OpenSSH Server... >> %LOG%
powershell -Command "Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0; Start-Service sshd; Set-Service -Name sshd -StartupType Automatic" >> %LOG% 2>&1

echo ==^> Installing SSH authorized key... >> %LOG%
mkdir C:\ProgramData\ssh 2>nul
copy "%~dp0authorized_keys" C:\ProgramData\ssh\administrators_authorized_keys >> %LOG% 2>&1
powershell -Command "icacls C:\ProgramData\ssh\administrators_authorized_keys /inheritance:r /grant '*S-1-5-18:(F)' /grant '*S-1-5-32-544:(F)'; Restart-Service sshd" >> %LOG% 2>&1

echo ==^> Downloading RubyInstaller 3.4.9 with DevKit... >> %LOG%
curl -L --retry 3 -o "%TEMP%\rubyinstaller.exe" "https://github.com/oneclick/rubyinstaller2/releases/download/RubyInstaller-3.4.9-1/rubyinstaller-devkit-3.4.9-1-x64.exe" >> %LOG% 2>&1
echo ==^> Installing Ruby 3.4 with DevKit (silent)... >> %LOG%
rem noridkinstall: we run ridk install 1 2 3 manually below; nomodpath: each shell script manages Ruby on PATH explicitly
"%TEMP%\rubyinstaller.exe" /verysilent /currentuser /dir="C:\Ruby34-x64" /components="ruby,rdoc,msys2" /tasks="noridkinstall,nomodpath" >> %LOG% 2>&1
echo ==^> Initializing MSYS2 base, system update, and MINGW development toolchain (ridk install 1 2 3)... >> %LOG%
call C:\Ruby34-x64\bin\ridk.cmd install 1 2 3 >> %LOG% 2>&1
echo ==^> Installing LLVM and clang via MSYS2... >> %LOG%
call C:\Ruby34-x64\bin\ridk.cmd exec sh -c 'pacman -Syu --needed --noconfirm $MINGW_PACKAGE_PREFIX-llvm $MINGW_PACKAGE_PREFIX-clang' >> %LOG% 2>&1

echo ==^> ruby version: >> %LOG%
C:\Ruby34-x64\bin\ruby.exe --version >> %LOG% 2>&1
echo ==^> llvm version: >> %LOG%
call C:\Ruby34-x64\bin\ridk.cmd exec sh -c "llvm-config --version" >> %LOG% 2>&1

echo ==^> Downloading RubyInstaller 3.4.9 (32-bit) with DevKit... >> %LOG%
curl -L --retry 3 -o "%TEMP%\rubyinstaller32.exe" "https://github.com/oneclick/rubyinstaller2/releases/download/RubyInstaller-3.4.9-1/rubyinstaller-devkit-3.4.9-1-x86.exe" >> %LOG% 2>&1
echo ==^> Installing Ruby 3.4 (32-bit) with DevKit (silent)... >> %LOG%
rem nomodpath — same reason as 64-bit install above
"%TEMP%\rubyinstaller32.exe" /verysilent /currentuser /dir="C:\Ruby34-x86" /components="ruby,rdoc,msys2" /tasks="noridkinstall,nomodpath" >> %LOG% 2>&1
echo ==^> Initializing MSYS2 MINGW32 toolchain for 32-bit Ruby (ridk install 1 2 3)... >> %LOG%
call C:\Ruby34-x86\bin\ridk.cmd install 1 2 3 >> %LOG% 2>&1
echo ==^> Downgrading MINGW32 gcc + gcc-libs to 15.2.0-14 to match LLVM 21.x (all i686 LLVM packages in the archive were compiled with GCC 15; GCC 16 orphan packages landed after LLVM was frozen)... >> %LOG%
call C:\Ruby34-x86\bin\ridk.cmd exec sh -c "pacman -U --noconfirm 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-gcc-15.2.0-14-any.pkg.tar.zst' 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-gcc-libs-15.2.0-14-any.pkg.tar.zst'" >> %LOG% 2>&1
echo ==^> Installing MINGW32 LLVM and clang for 32-bit Ruby (from MSYS2 archive via pacman -U -- removed from active repo but still hosted)... >> %LOG%
rem mingw-w64-i686-llvm* were dropped from the active MSYS2 i686 repo but still exist on repo.msys2.org;
rem pacman -U accepts URLs directly; llvm-libs provides libLLVM-21.dll needed by ruby-llvm at runtime
call C:\Ruby34-x86\bin\ridk.cmd exec sh -c "pacman -U --needed --noconfirm --disable-download-timeout 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-llvm-libs-21.1.8-4-any.pkg.tar.zst' 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-llvm-tools-21.1.8-4-any.pkg.tar.zst' 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-llvm-21.1.8-4-any.pkg.tar.zst' 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-clang-libs-21.1.8-4-any.pkg.tar.zst' 'https://repo.msys2.org/mingw/mingw32/mingw-w64-i686-clang-21.1.8-4-any.pkg.tar.zst'" >> %LOG% 2>&1
echo ==^> Creating LLVM-21.dll symlink (temporary; ruby-llvm 21 ffi_lib list lacks libLLVM-21.dll — fix upstream)... >> %LOG%
call C:\Ruby34-x86\bin\ridk.cmd exec sh -c "ln -sf /mingw32/bin/libLLVM-21.dll /mingw32/bin/LLVM-21.dll" >> %LOG% 2>&1
echo ==^> 32-bit ruby version: >> %LOG%
C:\Ruby34-x86\bin\ruby.exe --version >> %LOG% 2>&1
echo ==^> 32-bit llvm version: >> %LOG%
call C:\Ruby34-x86\bin\ridk.cmd exec sh -c "llvm-config --version" >> %LOG% 2>&1

echo ==^> Downloading Cygwin setup... >> %LOG%
rem saved to C:\cygwin-setup.exe so it persists across reboots
rem to add packages later: C:\cygwin-setup.exe --quiet-mode --no-shortcuts --root C:\cygwin64 --site "https://mirrors.kernel.org/sourceware/cygwin/" --local-package-dir "C:\cygwin-pkgs" --packages <pkg>
curl -L --retry 3 -o "C:\cygwin-setup.exe" "https://cygwin.com/setup-x86_64.exe" >> %LOG% 2>&1
echo ==^> Installing Cygwin with ruby, llvm, clang, and dev tools... >> %LOG%
rem --root C:\cygwin64: explicit; without it --no-admin would redirect install to %USERPROFILE%\cygwin64
rem no --no-admin: install.bat runs as SYSTEM/admin during first-boot OEM setup, so C:\cygwin64 is writable
rem --local-package-dir C:\cygwin-pkgs: persistent cache, reused by the add-packages command above
C:\cygwin-setup.exe --quiet-mode --no-shortcuts --root "C:\cygwin64" --site "https://mirrors.kernel.org/sourceware/cygwin/" --local-package-dir "C:\cygwin-pkgs" --packages ruby,ruby-devel,rubygems,llvm,libllvm-devel,clang,make,gcc-core,libffi-devel,libssl-devel,zlib-devel,git,curl >> %LOG% 2>&1
echo ==^> Cygwin ruby version: >> %LOG%
C:\cygwin64\bin\ruby.exe --version >> %LOG% 2>&1
echo ==^> Cygwin llvm-config version: >> %LOG%
C:\cygwin64\bin\bash.exe --login -c "llvm-config --version" >> %LOG% 2>&1

echo ==^> Setting BUNDLE_WITHOUT=development persistently (HKCU\Environment, inherited by all shells)... >> %LOG%
setx BUNDLE_WITHOUT development >> %LOG% 2>&1

echo ==^> Installing VS Build Tools 2022 (C++ workload for compiling mswin native gems)... >> %LOG%
curl -L --retry 3 -o "%TEMP%\vs_buildtools.exe" "https://aka.ms/vs/17/release/vs_buildtools.exe" >> %LOG% 2>&1
rem --wait blocks until VS setup completes; required before any MSVC compilation
"%TEMP%\vs_buildtools.exe" --wait --quiet --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended >> %LOG% 2>&1

echo ==^> Downloading 7zr.exe (handles .7z archives; needed to extract ruby-mswin.7z)... >> %LOG%
curl -L --retry 3 -o "C:\7zr.exe" "https://www.7-zip.org/a/7zr.exe" >> %LOG% 2>&1

echo ==^> Downloading mswin Ruby from MSP-Greg/ruby-loco (MSVC trunk build, extracts to C:\ruby-mswin)... >> %LOG%
rem only trunk builds available for mswin; same source used by setup-ruby for mswin head installs
curl -L --retry 3 -o "%TEMP%\ruby-mswin.7z" "https://github.com/MSP-Greg/ruby-loco/releases/download/ruby-master/ruby-mswin.7z" >> %LOG% 2>&1
echo ==^> Extracting mswin Ruby... >> %LOG%
C:\7zr.exe x "%TEMP%\ruby-mswin.7z" -o"C:\" -y >> %LOG% 2>&1
echo ==^> mswin ruby version: >> %LOG%
C:\ruby-mswin\bin\ruby.exe --version >> %LOG% 2>&1

echo ==^> Downloading vcpkg x64-windows packages (libffi + pkgconf — required for ffi gem system-libffi build on mswin; bundled libffi in ffi 1.17+ dropped Makefile.vc64)... >> %LOG%
curl -L --retry 3 -o "%TEMP%\vcpkg-x64-windows.7z" "https://github.com/ruby/setup-msys2-gcc/releases/latest/download/vcpkg-x64-windows.7z" >> %LOG% 2>&1
echo ==^> Extracting vcpkg packages to C:\vcpkg-ruby... >> %LOG%
C:\7zr.exe x "%TEMP%\vcpkg-x64-windows.7z" -o"C:\vcpkg-ruby" -y >> %LOG% 2>&1

echo ==^> mswin LLVM (via MSYS2 UCRT64, already installed above — no separate download needed): >> %LOG%
rem libLLVM-22.dll from UCRT64 is a standard Windows DLL (same x64 calling convention, UCRT ABI);
rem vsshell.bat queries ridk at runtime for the UCRT64 bin path and adds it to PATH.
rem TODO: for a proper MSVC build, both sources below ship LLVM-C.dll + llvm-config + headers + .lib files,
rem       but ffi_llvm_jit's ffi_lib list would need "LLVM-C" added (or a LLVM-22.dll hardlink to LLVM-C.dll):
rem         https://github.com/c3lang/win-llvm/releases             (llvm-X.Y.Z-windows-amd64-msvc17-msvcrt.7z)
rem         https://github.com/vovkos/llvm-package-windows/releases (also has x86 variant)
call C:\Ruby34-x64\bin\ridk.cmd exec sh -c "llvm-config --version" >> %LOG% 2>&1

echo ==^> Enabling Ctrl+Shift+C/Ctrl+Shift+V console copy/paste shortcuts (current context)... >> %LOG%
reg add "HKCU\Console" /v ForceV2 /t REG_DWORD /d 1 /f >> %LOG% 2>&1
reg add "HKCU\Console" /v CtrlKeyShortcutsDisabled /t REG_DWORD /d 1 /f >> %LOG% 2>&1
reg add "HKCU\Console" /v QuickEdit /t REG_DWORD /d 1 /f >> %LOG% 2>&1
reg add "HKCU\Console" /v InterceptCopyPaste /t REG_DWORD /d 1 /f >> %LOG% 2>&1
rem install.bat's own context (SYSTEM vs Docker user) is unclear, so also
rem schedule the same fix to run as whichever user next logs in interactively.
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v EnableConsoleShortcuts /t REG_SZ /d "cmd /c reg add \"HKCU\Console\" /v ForceV2 /t REG_DWORD /d 1 /f & reg add \"HKCU\Console\" /v CtrlKeyShortcutsDisabled /t REG_DWORD /d 1 /f & reg add \"HKCU\Console\" /v QuickEdit /t REG_DWORD /d 1 /f & reg add \"HKCU\Console\" /v InterceptCopyPaste /t REG_DWORD /d 1 /f" /f >> %LOG% 2>&1

echo ==^> install.bat finished. >> %LOG%

echo done > Z:\mise-tasks\debug-win-storage\win-setup-done
ENDBAT

# `pacman -Sy` (sync only) vs `-Syu` (sync+upgrade) — `-Sy` alone caused a real dependency conflict (`mingw-w64-ucrt-x86_64-gcc-libs` version pin) when installing `mingw-w64-ucrt-x86_64-llvm`; fixed with `-Syu`

# echo ==^> Running bundle install (64-bit)... >> %LOG%
# set BUNDLE_GEMFILE=Z:\gemfiles\Gemfile-win
# cd /d Z:\
# C:\Ruby34-x64\bin\bundle install >> %LOG% 2>&1

# echo ==^> Running bundle install (Cygwin)... >> %LOG%
# C:\cygwin64\bin\bash.exe --login -c "cd /cygdrive/z && BUNDLE_GEMFILE=gemfiles/Gemfile-cygwin bundle install" >> %LOG% 2>&1

# Win32-OpenSSH wraps every command in cmd /c "..." — any " inside closes the outer wrapper early,
# breaking nested -Command "..." or -c "..." arguments. Bat files in STORAGE_DIR (served via Z:) let
# each SSH command have zero inner quotes while the bat file itself can use " freely.
cat > "${STORAGE_DIR}/shell-powershell.bat" << 'ENDPWSH'
@echo off
powershell.exe -NoExit -Command "& C:\Ruby34-x64\bin\ridk.ps1 enable; $env:PATH = 'C:\Ruby34-x64\bin;' + $env:PATH; $env:BUNDLE_GEMFILE = 'Z:\gemfiles\Gemfile-win'; Set-Location Z:"
ENDPWSH

cat > "${STORAGE_DIR}/shell-cmd.bat" << 'ENDCMD'
@echo off
set PATH=C:\Ruby34-x64\bin;%PATH%
set BUNDLE_GEMFILE=Z:\gemfiles\Gemfile-win
cd /d Z:\
cmd
ENDCMD

cat > "${STORAGE_DIR}/shell-bash.bat" << 'ENDBASH'
@echo off
C:\Ruby34-x64\bin\ridk.cmd exec bash -c "export PATH=/c/Ruby34-x64/bin:$PATH BUNDLE_GEMFILE=/z/gemfiles/Gemfile-win && cd /z && exec bash"
ENDBASH

cat > "${STORAGE_DIR}/shell-bash32.bat" << 'ENDBASH32'
@echo off
C:\Ruby34-x86\bin\ridk.cmd exec bash -c "export PATH=/c/Ruby34-x86/bin:$PATH BUNDLE_GEMFILE=/z/gemfiles/Gemfile-win32 && cd /z && exec bash"
ENDBASH32

cat > "${STORAGE_DIR}/shell-cygwin.bat" << 'ENDCYGWIN'
@echo off
C:\cygwin64\bin\bash.exe --login -c "export BUNDLE_GEMFILE=/cygdrive/z/gemfiles/Gemfile-cygwin && cd /cygdrive/z && exec bash --login"
ENDCYGWIN

cat > "${STORAGE_DIR}/vsshell.bat" << 'ENDVSSHELL'
@echo off
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\Tools\VsDevCmd.bat" -arch=x64
rem ridk knows where its bundled MSYS2 lives; cygpath -w converts the POSIX /ucrt64/bin to a Windows path.
rem for /f "delims=" captures the full line (no field splitting); %%P receives e.g. C:\Ruby34-x64\msys64\ucrt64\bin.
rem This puts libLLVM-22.dll and llvm-config.exe on PATH without hardcoding the MSYS2 install location.
for /f "delims=" %%P in ('C:\Ruby34-x64\bin\ridk.cmd exec sh -c "cygpath -w /ucrt64/bin"') do set PATH=C:\ruby-mswin\bin;%%P;%PATH%
rem vcpkg-ruby: pre-built MSVC-compatible libffi + pkgconf downloaded by install.bat.
rem ffi gem's extconf detects system libffi via INCLUDE/LIB and skips the bundled build (which
rem lost Makefile.vc64 in ffi 1.17+). PKG_CONFIG_PATH lets pkg_config("libffi") succeed first.
set INCLUDE=C:\vcpkg-ruby\installed\x64-windows\include;%INCLUDE%
set LIB=C:\vcpkg-ruby\installed\x64-windows\lib;%LIB%
set PKG_CONFIG_PATH=C:\vcpkg-ruby\installed\x64-windows\lib\pkgconfig
set PATH=C:\vcpkg-ruby\installed\x64-windows\tools\pkgconf;C:\vcpkg-ruby\installed\x64-windows\bin;%PATH%
set BUNDLE_GEMFILE=Z:\gemfiles\Gemfile-mswin
powershell.exe -NoExit -Command Set-Location Z:\
ENDVSSHELL

cat > "${STORAGE_DIR}/vsshell-cmd.bat" << 'ENDVSCMD'
@echo off
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\Tools\VsDevCmd.bat" -arch=x64
rem See vsshell.bat for an explanation of the for /f + cygpath trick.
for /f "delims=" %%P in ('C:\Ruby34-x64\bin\ridk.cmd exec sh -c "cygpath -w /ucrt64/bin"') do set PATH=C:\ruby-mswin\bin;%%P;%PATH%
rem See vsshell.bat for an explanation of the vcpkg-ruby paths.
set INCLUDE=C:\vcpkg-ruby\installed\x64-windows\include;%INCLUDE%
set LIB=C:\vcpkg-ruby\installed\x64-windows\lib;%LIB%
set PKG_CONFIG_PATH=C:\vcpkg-ruby\installed\x64-windows\lib\pkgconfig
set PATH=C:\vcpkg-ruby\installed\x64-windows\tools\pkgconf;C:\vcpkg-ruby\installed\x64-windows\bin;%PATH%
set BUNDLE_GEMFILE=Z:\gemfiles\Gemfile-mswin
cd /d Z:\
cmd
ENDVSCMD

KVM_FLAG=""
if [[ -e /dev/kvm ]]; then
  KVM_FLAG="--device /dev/kvm"
else
  echo "WARNING: /dev/kvm not found — VM will run without hardware acceleration (very slow)"
fi

if [[ -n "${usage_iso:-}" && -z "${usage_rebuild:-}" ]]; then
  echo "WARNING: --iso has no effect without --rebuild (it only controls what a fresh install uses); ignoring" >&2
  usage_iso=""
fi

if [[ -z "${usage_iso:-}" && -f "$ISO_CACHE" ]]; then
  usage_iso="$(cat "$ISO_CACHE")"
fi

ISO_MOUNT=""
if [[ -n "${usage_iso:-}" ]]; then
  usage_iso="$(realpath "$usage_iso")"
  if [[ ! -f "$usage_iso" ]]; then
    echo "ERROR: ISO file not found: $usage_iso" >&2
    exit 1
  fi
  echo "$usage_iso" > "$ISO_CACHE"
  # dockur/windows expects whatever custom ISO was used at install time to stay mounted
  # on every subsequent boot, even after Windows is fully installed — otherwise it treats
  # the install as broken, backs up the disk, and starts over. Caching the path and
  # re-mounting it automatically on plain runs is what prevents that.
  ISO_MOUNT="-v ${usage_iso}:/boot.iso"
  echo "==> Using local ISO: $usage_iso"
fi

echo "==> Starting Windows Server 2022 VM..."
echo "==> Open http://localhost:8006 in your browser to connect via noVNC"
echo "==> RDP also available at localhost:3389"
echo "==> First boot: Windows installs (~5 min), then install.bat runs (~10 min)"
echo "==> On subsequent runs the VM resumes from saved state (much faster)"
echo "==> Project is available at Z:\\ inside Windows"

trap 'docker rm -f "$RUN_CONTAINER" 2>/dev/null || true' EXIT

# shellcheck disable=SC2086
docker run --rm -d \
  --name "$RUN_CONTAINER" \
  $KVM_FLAG \
  $ISO_MOUNT \
  --cap-add NET_ADMIN \
  -p 2222:22 \
  -p 8006:8006 \
  -p 3389:3389 \
  -e VERSION="win2025" \
  -e RAM_SIZE="4G" \
  -e CPU_CORES="4" \
  -e DISK_SIZE="64G" \
  -v "${VOLUME}:/storage" \
  -v "${OEM_DIR}:/oem" \
  -v "${PROJECT_ROOT}:/shared" \
  dockurr/windows

docker logs -f "$RUN_CONTAINER" &
LOGS_PID=$!

LOG_LINES_SHOWN=0
if [[ ! -f "$SENTINEL" ]]; then
  echo "==> First run: waiting for Windows setup to complete (~15 min)..."
  until [[ -f "$SENTINEL" ]]; do
    sleep 30
    if [[ -f "$INSTALL_LOG" ]]; then
      NEW_LINES="$(tail -n +$((LOG_LINES_SHOWN + 1)) "$INSTALL_LOG")"
      LOG_LINES_SHOWN=$(wc -l < "$INSTALL_LOG")
      if [[ -n "$NEW_LINES" ]]; then
        echo "$NEW_LINES"
      else
        echo "    still waiting (no new lines in win-install.log)..."
      fi
    else
      echo "    still waiting (Windows hasn't finished its own first-boot setup yet; install.bat hasn't started)..."
    fi
  done
  echo "==> Setup complete."
fi

echo "==> Waiting for SSH to become available..."
until ssh -i "$SSH_KEY" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=3 -p 2222 Docker@localhost "exit 0" 2>/dev/null; do
  sleep 5
  echo "    still waiting..."
done

kill "$LOGS_PID" 2>/dev/null || true
wait "$LOGS_PID" 2>/dev/null || true
echo "==> Connecting (project available at Z:\\)..."
# net use's /persistent:yes only auto-restores for the account/session that created it
# (install.bat runs as a different logon than the SSH session), so each new SSH session
# needs its own remap; chaining it onto the remote command is simpler than fighting that.
NET_USE_Z='net use Z: \\host.lan\Data /persistent:yes >nul 2>&1'
SSH="ssh -t -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p 2222 Docker@localhost"
# Win32-OpenSSH wraps every command in cmd /c "..." — any " inside closes the outer wrapper, so
# nested -Command "..." or -c "..." all fail with "string is missing the terminator". Each case
# calls a bat file in STORAGE_DIR (served as Z:) so the SSH string has zero inner quotes.
case "$usage_shell" in
  cmd)
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\shell-cmd.bat"
    ;;
  bash)
    # MINGW64 environment; /c/Ruby34-x64/bin is the MSYS2 path for C:\Ruby34-x64\bin.
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\shell-bash.bat"
    ;;
  bash32)
    # MINGW32 environment for 32-bit Ruby; Gemfile-win32 pins ruby-llvm ~> 21 (MSYS2 i686 max).
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\shell-bash32.bat"
    ;;
  cygwin)
    # Cygwin: /cygdrive/z for Z:; td_errno = C errno, td_winapi_errno = GetLastError() (distinct channels).
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\shell-cygwin.bat"
    ;;
  mswin)
    # VS dev env + mswin Ruby + LLVM via MSYS2 UCRT64 (ridk-resolved path). PowerShell interactive.
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\vsshell.bat"
    ;;
  mswin-cmd)
    # Same as mswin but drops into cmd.exe instead of PowerShell.
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\vsshell-cmd.bat"
    ;;
  *)
    # Default PowerShell: ridk.ps1 runs in-process (unlike ridk.cmd) so $env: changes survive into -NoExit.
    $SSH "${NET_USE_Z} & Z:\\mise-tasks\\debug-win-storage\\shell-powershell.bat"
    ;;
esac


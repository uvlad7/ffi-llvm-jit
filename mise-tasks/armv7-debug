#!/usr/bin/env bash
#MISE description="Spin up armv7 Ubuntu 24.04 QEMU container for debugging"
#USAGE flag "--rebuild" help="Force rebuild of the cached image"
set -euo pipefail

PROJECT_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
IMAGE="ffi-llvm-jit-armv7-debug:latest"
CONTAINER_NAME="ffi-llvm-jit-armv7-build-$$"

if [[ -n "${usage_rebuild:-}" ]]; then
  docker rmi "$IMAGE" 2>/dev/null || true
fi

echo "==> Registering QEMU binfmt handlers..."
docker run --rm --privileged multiarch/qemu-user-static --reset -p yes

if ! docker image inspect "$IMAGE" &>/dev/null; then
  echo "==> Building cached image (first run only)..."
  trap 'docker rm -f "$CONTAINER_NAME" 2>/dev/null || true' EXIT
  docker run \
    --name "$CONTAINER_NAME" \
    --platform linux/arm/v7 \
    -v "${PROJECT_ROOT}:/workspace" \
    -w /workspace \
    ubuntu:24.04 \
    bash -c '
      set -e
      apt-get update -qq
      apt-get install -y --no-install-recommends \
        ruby ruby-dev ruby-bundler build-essential llvm-18-dev clang-18 nano
      echo "ruby version: $(ruby --version)"
      echo "llvm version: $(llvm-config-18 --version)"
      export BUNDLE_WITHOUT=development
      bundle install
    '
  docker commit --change "ENV BUNDLE_WITHOUT=development" "$CONTAINER_NAME" "$IMAGE"
fi

echo "==> Starting armv7 Ubuntu 24.04 container (matches CI)..."
docker run --rm -it \
  --platform linux/arm/v7 \
  --cap-add=SYS_PTRACE \
  --security-opt seccomp=unconfined \
  -v "${PROJECT_ROOT}:/workspace" \
  -v "${HOME}/ruby-llvm:/ruby-llvm" \
  -w /workspace \
  "$IMAGE" \
  bash
